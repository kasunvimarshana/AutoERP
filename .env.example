APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
PLATFORM_PUBLIC_URL=http://127.0.0.1:8000
VITE_PLATFORM_PUBLIC_URL="${PLATFORM_PUBLIC_URL}"
PLATFORM_OPERATOR_INVITATION_URL=${PLATFORM_PUBLIC_URL}/register/platform-operator
PLATFORM_OPERATOR_INVITATION_TTL_MINUTES=1440
PLATFORM_OPERATOR_INVITATION_DELIVERY_LEASE_SECONDS=300
APP_RELEASE=local
APP_COMMIT_SHA=

PDF_DRIVER=dompdf
PDF_PAPER_SIZE=A4
PDF_ORIENTATION=portrait
REPORT_EXPORT_ROW_LIMIT=5000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

AUTH_ACCESS_TOKEN_TTL=3600
AUTH_REFRESH_TOKEN_TTL=2592000
AUTH_TENANT_REFRESH_COOKIE_NAME=autoerp_tenant_refresh
AUTH_TENANT_REFRESH_COOKIE_PATH=/api/v1/auth
# AUTH_TENANT_REFRESH_COOKIE_DOMAIN=
# AUTH_TENANT_REFRESH_COOKIE_SECURE=true
AUTH_TENANT_REFRESH_COOKIE_SAME_SITE=strict
AUTH_PLATFORM_REFRESH_COOKIE_NAME=autoerp_platform_refresh
AUTH_PLATFORM_REFRESH_COOKIE_PATH=/api/v1/platform/auth
# AUTH_PLATFORM_REFRESH_COOKIE_DOMAIN=
# AUTH_PLATFORM_REFRESH_COOKIE_SECURE=true
AUTH_PLATFORM_REFRESH_COOKIE_SAME_SITE=strict
AUTH_REGISTRATION_INVITATION_EXPIRY_HOURS=72
AUTH_REGISTRATION_DELIVERY_LEASE_SECONDS=300
AUTH_REGISTRATION_DELIVERY_STALE_AFTER_SECONDS=900
AUTH_REGISTRATION_INVITATION_URL="${PLATFORM_PUBLIC_URL}/register/invitation"
AUTH_PLATFORM_MFA_ENABLED=true
AUTH_PLATFORM_MFA_REQUIRED=true
AUTH_PLATFORM_MFA_LOGIN_CHALLENGE=true
AUTH_PLATFORM_MFA_STEP_UP_REQUIRED=true
AUTH_PLATFORM_MFA_ISSUER="${APP_NAME}"
AUTH_PLATFORM_STEP_UP_TTL_SECONDS=900

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
PRIVATE_OBJECT_DEFAULT_DISK="${FILESYSTEM_DISK}"
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_API_BASE_URL="${APP_URL}"

AUTOERP_CURRENCY_CODE=LKR

# SaaS tenant routing and platform administration
TENANT_DATABASE_STRATEGY=shared_schema
TENANT_CENTRAL_HOSTS=127.0.0.1,localhost
TENANT_LOCAL_FALLBACK_ENABLED=true
TENANT_LOCAL_FALLBACK_TENANT_CODE=AUTOERP
AUTOERP_TENANT_CODE=AUTOERP
AUTOERP_TENANT_NAME=AutoERP
AUTOERP_SEED_PLATFORM_OPERATOR=false
AUTOERP_PLATFORM_ADMIN_EMAIL=
TRUSTED_PROXIES=
TENANT_DOCUMENT_DISK=tenant_private
TENANT_DOCUMENT_MAX_SIZE_KB=10240
TENANT_DOCUMENT_SCANNER=trusted_local
TENANT_DOCUMENT_CLAMAV_HOST=127.0.0.1
TENANT_DOCUMENT_CLAMAV_PORT=3310
TENANT_DOCUMENT_CLAMAV_TIMEOUT_SECONDS=10
TENANT_ONBOARDING_OPERATION_LEASE_MINUTES=15
VEHICLE_SERVICE_DOCUMENT_DISK=tenant_private
VEHICLE_SERVICE_DOCUMENT_MAX_SIZE_KB=10240
TENANT_DOMAIN_VERIFICATION_TTL_MINUTES=1440
TENANT_DOMAIN_REVALIDATION_INTERVAL_HOURS=24
TENANT_DOMAIN_VERIFICATION_GRACE_DAYS=7
TENANT_DOMAIN_REVALIDATION_BATCH_SIZE=100
TENANT_DOMAIN_REVALIDATION_CLAIM_TIMEOUT_MINUTES=30
TENANT_DOMAIN_OPERATIONAL_CONNECT_TIMEOUT_SECONDS=5
TENANT_DOMAIN_OPERATIONAL_TIMEOUT_SECONDS=10
TENANT_DOMAIN_OPERATIONAL_RETRY_MINUTES=15
TENANT_DOMAIN_MINIMUM_TLS_VALIDITY_DAYS=1
TENANT_DOMAIN_PROBE_RATE_LIMIT_PER_MINUTE=120
TENANT_DOMAIN_VERIFICATION_RATE_LIMIT_PER_MINUTE=10
TENANT_EVENT_OUTBOX_BATCH_SIZE=100
TENANT_EVENT_OUTBOX_MAX_ATTEMPTS=10
TENANT_EVENT_OUTBOX_CLAIM_TIMEOUT_SECONDS=600
TENANT_EVENT_OUTBOX_PUBLISHED_RETENTION_DAYS=30
TENANT_STORAGE_CLEANUP_BATCH_SIZE=100
TENANT_STORAGE_CLEANUP_MAX_ATTEMPTS=10
TENANT_STORAGE_CLEANUP_CLAIM_TIMEOUT_SECONDS=900
